# Maintainer: Aeryxium <base64 -d <<<"YWVyeXhpdW0rYXJjaEBnbWFpbC5jb20K">
# /etc/systemd/network/95-wireless.network
#
# Wireless network configuration for systemd.networkd
# https://www.freedesktop.org/software/systemd/man/systemd.network.html

[Match]
Name=w*

[Network]
DHCP=ipv4
DNSSEC=false

[DHCP]
RouteMetric=20
UseDomains=true

[Link]
RequiredForOnline=routable
