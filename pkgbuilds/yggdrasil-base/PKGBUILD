package() {
	install -Dm0755 "$srcdir/setup.sh"              "$pkgdir/etc/skel/.config/shell/setup.sh"
	install -Dm0644 "$srcdir/bash_login"            "$pkgdir/etc/skel/.config/shell/bash/.bash_login"
	install -Dm0644 "$srcdir/zlogin"                "$pkgdir/etc/skel/.config/shell/zsh/.zlogin"
	install -Dm0644 "$srcdir/zshenv"                "$pkgdir/etc/zsh/zshenv"

	install -Dm0644 "$srcdir/i18n-locales-en_CA_24" "$pkgdir/usr/share/i18n/locales/en_CA_24"
	install -Dm0644 "$srcdir/us-ctrlcaps.map.gz"    "$pkgdir/usr/share/kbd/keymaps/i386/qwerty/us-ctrlcaps.map.gz"

	install -dm0750                                 "$pkgdir/etc/sudoers.d"
	install -Dm0440 "$srcdir/sudoers.d-10-wheel"    "$pkgdir/etc/sudoers.d/10-wheel"
	install -Dm0644 "$srcdir/sshd-yggdrasil.conf"   "$pkgdir/etc/ssh/sshd_config.d/50-yggdrasil.conf"
	install -Dm0655 "$srcdir/polkit-pcscd.rules"    "$pkgdir/etc/polkit-1/rules.d/99-pcscd.rules"

	install -Dm0755 "$srcdir/mirrorupdate"          "$pkgdir/usr/bin/mirrorupdate"
	install -Dm0644 "$srcdir/mirrorupdate.timer"    "$pkgdir/usr/lib/systemd/system/mirrorupdate.timer"
	install -Dm0644 "$srcdir/mirrorupdate.service"  "$pkgdir/usr/lib/systemd/system/mirrorupdate.service"

	install -Dm0644 "$srcdir/motd-10-base"          "$pkgdir/etc/yggdrasil/motd/10-base"
	install -Dm0644 "$srcdir/issue"                 "$pkgdir/etc/yggdrasil/issue"
	install -Dm0644 "$srcdir/locale.conf"           "$pkgdir/etc/yggdrasil/locale.conf"
	install -Dm0644 "$srcdir/makepkg.conf"          "$pkgdir/etc/yggdrasil/makepkg.conf"
	install -Dm0644 "$srcdir/mkinitcpio.conf"       "$pkgdir/etc/yggdrasil/mkinitcpio.conf"
	install -Dm0644 "$srcdir/pacman.conf"           "$pkgdir/etc/yggdrasil/pacman.conf"
	install -Dm0644 "$srcdir/vconsole.conf"         "$pkgdir/etc/yggdrasil/vconsole.conf"
}
