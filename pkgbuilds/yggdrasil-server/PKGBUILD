package_yggdrasil-server() {
	pkgdesc="A base set of packages required by all yggdrasil servers"
	depends=(
		'yggdrasil-base'
		'yggdrasil-admin'
		'yggdrasil-boot-linux'
		'yggdrasil-boot-lts'
		'yggdrasil-networking-wired'

		'borg'
		'conntrack-tools'
		'nftables'
		'tcpdump'
	)
	conflicts=('yggdrasil-workstation')
	install=""
}

package_yggdrasil-folkvangr() {
	pkgdesc="Packages required for the folkvangr infrastructure server"
	depends=(
		'yggdrasil-cpu-intel'
		'yggdrasil-server'

		'certbot-dns-dnsimple'
		'certbot-nginx'
		'lighttpd'
		'nginx-mainline'
		'php-cgi'
		'php-fpm'
		'php-sqlite'
		'pi-hole-core'
		'pi-hole-ftl'
		'sshguard'
		'wireguard-tools'
		'yubico-pam'
	)
	conflicts=('yggdrasil-valhalla')
	backup=(
		'etc/hostname'
		'etc/ssh/sshd_config.d/10-folkvangr.conf'
	)

	install -Dm0644 "$srcdir/folkvangr-hostname"    "$pkgdir/etc/hostname"
	install -Dm0644 "$srcdir/folkvangr-sshd_config" "$pkgdir/etc/ssh/sshd_config.d/10-folkvangr.conf"
	install -Dm0644 "$srcdir/motd-50-folkvangr"     "$pkgdir/etc/yggdrasil/motd/50-folkvangr"
}

package_yggdrasil-valhalla() {
	pkgdesc="Packages required for the valhalla applications server"
	depends=(
		'yggdrasil-cpu-amd'
		'yggdrasil-server'

		'docker'
		'docker-compose'
		'ffmpeg-cuda-full'
		'ipmitool'
		'jellyfin-ffmpeg'
		'lazydocker'
		'mediainfo'
		'nullmailer'
		'nvidia-container-toolkit'
		'nvidia-open-dkms'
		's-nail'
		'samba'
		'smartmontools'
		'zfs-dkms'
		'zfs-utils'
	)
	conflicts=('yggdrasil-folkvangr')
	backup=(
		'etc/hostname'
		'etc/systemd/system/systemd-networkd-wait-online.service.d/override.conf'
		'usr/lib/sysusers.d/sysusers.yggdrasil-valhalla.conf'
	)

	install -Dm0644 "$srcdir/valhalla-hostname"                "$pkgdir/etc/hostname"
	install -Dm0644 "$srcdir/valhalla-override.conf"           "$pkgdir/etc/systemd/system/systemd-networkd-wait-online.service.d/override.conf"
	install -Dm0644 "$srcdir/motd-50-valhalla"                 "$pkgdir/etc/yggdrasil/motd/50-valhalla"

	install -Dm0644 "$srcdir/sysusers.yggdrasil-valhalla.conf" "$pkgdir/usr/lib/sysusers.d/yggdrasil-valhalla.conf"

	install -Dm0644 "$srcdir/nullmailer-adminaddr"             "$pkgdir/etc/nullmailer/adminaddr"
	install -Dm0644 "$srcdir/nullmailer-allmailfrom"           "$pkgdir/etc/nullmailer/allmailfrom"
	install -Dm0644 "$srcdir/nullmailer-defaultdomain"         "$pkgdir/etc/nullmailer/defaultdomain"

	install -Dm0644 "$srcdir/data1.timer-schedule.conf"        "$pkgdir/etc/systemd/system/zfs-scrub-monthly@data1.timer.d/schedule.conf"
	install -Dm0644 "$srcdir/data2.timer-schedule.conf"        "$pkgdir/etc/systemd/system/zfs-scrub-monthly@data2.timer.d/schedule.conf"
	install -Dm0644 "$srcdir/data3.timer-schedule.conf"        "$pkgdir/etc/systemd/system/zfs-scrub-monthly@data3.timer.d/schedule.conf"
}
