pkgbase="yggdrasil-server"
pkgname=(
	"yggdrasil-server"
	"yggdrasil-folkvangr"
	"yggdrasil-valhalla"
)
pkgver=1
pkgrel=1
pkgdesc="A base set of packages required by all yggdrasil servers"
arch=("any")
url="https://github.com/opsipolymath/yggdrasil"
license=("GPL-3.0-or-later")
depends=()
makedepends=()
optdepends=()
provides=()
conflicts=()
replaces=()
backup=(
)
install="${pkgname}.install"
source=(
	# ---- yggdrasil-server

	# ---- yggdrasil-folkvangr
	'folkvangr-hostname'
	'folkvangr-sshd_config'
	'motd-50-folkvangr'

	# ---- yggdrasil-valhalla
	'valhalla-hostname'
	'valhalla-override.conf'
	'motd-50-valhalla'
	'sysusers.yggdrasil-valhalla.conf'
)
md5sums=('08c8f8e0bfef3fe721cd76135de3a96c'
         '655d7890ae5281b7b4e0b9339ebe820f'
         '69a5d30608abd1c1cccbdb2ee6b65078'
