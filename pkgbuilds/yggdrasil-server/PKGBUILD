	'folkvangr-sshd_config'
	'motd-50-folkvangr'

	# ---- yggdrasil-valhalla
	'valhalla-hostname'
	'valhalla-override.conf'
	'motd-50-valhalla'
	'nullmailer-adminaddr'
	'nullmailer-allmailfrom'
